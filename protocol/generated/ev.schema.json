{
  "$defs": {
    "AccessLevel": {
      "description": "What the user has said about one application.",
      "enum": [
        "open",
        "ask",
        "verify",
        "blocked"
      ],
      "title": "AccessLevel",
      "type": "string"
    },
    "Assurance": {
      "description": "What a call must satisfy before it runs.",
      "enum": [
        "none",
        "ack",
        "owner",
        "owner_and_password"
      ],
      "title": "Assurance",
      "type": "string"
    },
    "AudioSubmit": {
      "additionalProperties": false,
      "description": "Recorded speech, on its way to be transcribed.\n\nThe host captures, because the microphone is a TCC surface and TCC grants\nattach to a code signature. The core transcribes, because that is where\n`SpeechRecognizer` lives and where the engine stays replaceable (ADR 0018).\n\nBase64 rather than a file path: a path means the audio is written to disk\nby one process and read by another, and neither owns deleting it. ~2.5\nseconds of 16 kHz mono is about 100 KB encoded, which is nothing on a local\nsocket.",
      "properties": {
        "audio": {
          "description": "base64 of a mono 16-bit PCM WAV.",
          "maxLength": 8000000,
          "title": "Audio",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The language to transcribe as. Never 'auto': auto-detect is unreliable on short utterances, and a misdetected language becomes a tool argument.",
          "title": "Locale"
        },
        "sample_rate": {
          "default": 16000,
          "maximum": 48000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "type": {
          "const": "audio.submit",
          "default": "audio.submit",
          "title": "Type",
          "type": "string"
        },
        "wake": {
          "default": false,
          "description": "This is room audio, not a request. Transcribe it, and act only if it began with E.V.'s name; if it did not, answer that nothing was meant and record nothing. The host sends these continuously while the wake loop runs.",
          "title": "Wake",
          "type": "boolean"
        }
      },
      "required": [
        "audio"
      ],
      "title": "AudioSubmit",
      "type": "object"
    },
    "ConfirmationRequired": {
      "additionalProperties": false,
      "description": "A question, and what would answer it.\n\n`assurance` is not decoration. A surface that cannot satisfy it must\ndecline rather than answer with something weaker, and it can only know\nthat if it is told -- a click is not macOS verifying the owner.",
      "properties": {
        "application": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which application would be touched, when one would. The question should name it: the user set a level for it, and the answer can change that level.",
          "title": "Application"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "assurance": {
          "$ref": "#/$defs/Assurance",
          "default": "ack",
          "description": "How the yes has to be given for this call to run."
        },
        "id": {
          "description": "Echoed back in confirmation.respond.",
          "title": "Id",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "confirmation.required",
          "default": "confirmation.required",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool",
        "risk"
      ],
      "title": "ConfirmationRequired",
      "type": "object"
    },
    "ConfirmationRespond": {
      "additionalProperties": false,
      "properties": {
        "granted": {
          "title": "Granted",
          "type": "boolean"
        },
        "remember": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Also set this application's level. `open` for 'always', `blocked` for 'never', absent for 'just this once'. The application is the one named in the question -- a client cannot set a level for something it was not asked about."
        },
        "request": {
          "description": "The id of the confirmation.required event.",
          "title": "Request",
          "type": "string"
        },
        "type": {
          "const": "confirmation.respond",
          "default": "confirmation.respond",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request",
        "granted"
      ],
      "title": "ConfirmationRespond",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "description": "First message on every connection. Nothing else is served until it is\naccepted.",
      "properties": {
        "client": {
          "description": "Who is connecting, for the log.",
          "title": "Client",
          "type": "string"
        },
        "protocol": {
          "description": "The protocol version the client speaks.",
          "title": "Protocol",
          "type": "string"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        },
        "verifies": {
          "default": false,
          "description": "Whether this client can ask macOS to verify the owner. Only the signed app can. A client that says no is never asked a question it could only answer with something weaker, and saying yes falsely gains nothing: macOS does the asking, not the client.",
          "title": "Verifies",
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "client"
      ],
      "title": "Hello",
      "type": "object"
    },
    "HistoryPage": {
      "additionalProperties": false,
      "description": "What a `history.query` answers with, inside the response payload.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/JournalEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "title": "HistoryPage",
      "type": "object"
    },
    "HistoryQuery": {
      "additionalProperties": false,
      "description": "What E.V. has done, newest first.\n\nA request rather than an event: history is asked for, not pushed. The\nanswer arrives in the response payload as `entries`, shaped like\n`JournalEntry` below.",
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only entries older than this id. For paging.",
          "title": "Before"
        },
        "limit": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search the trail instead of paging it: a tool, an album, a note's title. Accents are folded. Ignores `before`, because a search is not a page.",
          "title": "Query"
        },
        "type": {
          "const": "history.query",
          "default": "history.query",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "HistoryQuery",
      "type": "object"
    },
    "JournalEntry": {
      "additionalProperties": false,
      "description": "What E.V. did, once.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "recorded_at": {
          "description": "ISO 8601, UTC, stamped when it happened.",
          "title": "Recorded At",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "speech": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "recorded_at",
        "tool",
        "risk",
        "ok"
      ],
      "title": "JournalEntry",
      "type": "object"
    },
    "Permission": {
      "description": "A capability macOS gates behind TCC.",
      "enum": [
        "microphone",
        "camera",
        "accessibility",
        "apple_events"
      ],
      "title": "Permission",
      "type": "string"
    },
    "PermissionChanged": {
      "additionalProperties": false,
      "description": "The native host reporting what macOS says. The Python core never infers\nthis (invariant 7); it only ever learns it here.",
      "properties": {
        "permission": {
          "$ref": "#/$defs/Permission"
        },
        "state": {
          "$ref": "#/$defs/PermissionState"
        },
        "type": {
          "const": "permission.changed",
          "default": "permission.changed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "permission",
        "state"
      ],
      "title": "PermissionChanged",
      "type": "object"
    },
    "PermissionReport": {
      "additionalProperties": false,
      "description": "What macOS said about a permission, from the process it said it to.\n\nInvariant 7: permission state is reported by the signed host, never\ninferred by the core. This is that report. Only the host can know whether\na camera opened or a microphone was refused, because it is the process\nmacOS answered.\n\nSent when there is evidence -- a device that opened, a prompt that was\nanswered -- and not on a schedule. A permission nobody has exercised is\n`undetermined`, which is a true statement rather than a missing one.",
      "properties": {
        "permission": {
          "$ref": "#/$defs/Permission"
        },
        "state": {
          "$ref": "#/$defs/PermissionState"
        },
        "type": {
          "const": "permission.report",
          "default": "permission.report",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "permission",
        "state"
      ],
      "title": "PermissionReport",
      "type": "object"
    },
    "PermissionState": {
      "description": "What the host last reported for a permission.",
      "enum": [
        "granted",
        "denied",
        "undetermined"
      ],
      "title": "PermissionState",
      "type": "string"
    },
    "Request": {
      "additionalProperties": false,
      "description": "A command with an id. Exactly one `Response` carries the same id back.",
      "properties": {
        "command": {
          "discriminator": {
            "mapping": {
              "audio.submit": "#/$defs/AudioSubmit",
              "confirmation.respond": "#/$defs/ConfirmationRespond",
              "hello": "#/$defs/Hello",
              "history.query": "#/$defs/HistoryQuery",
              "permission.report": "#/$defs/PermissionReport",
              "session.cancel": "#/$defs/SessionCancel",
              "utterance.submit": "#/$defs/UtteranceSubmit",
              "vision.submit": "#/$defs/VisionSubmit"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Hello"
            },
            {
              "$ref": "#/$defs/UtteranceSubmit"
            },
            {
              "$ref": "#/$defs/AudioSubmit"
            },
            {
              "$ref": "#/$defs/VisionSubmit"
            },
            {
              "$ref": "#/$defs/ConfirmationRespond"
            },
            {
              "$ref": "#/$defs/HistoryQuery"
            },
            {
              "$ref": "#/$defs/PermissionReport"
            },
            {
              "$ref": "#/$defs/SessionCancel"
            }
          ],
          "title": "Command"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "command"
      ],
      "title": "Request",
      "type": "object"
    },
    "Response": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "title": "Response",
      "type": "object"
    },
    "ResponseError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ResponseError",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Declared per tool in `tools.py`, never inferred from the arguments.",
      "enum": [
        "safe",
        "sensitive",
        "destructive"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SessionCancel": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session.cancel",
          "default": "session.cancel",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "SessionCancel",
      "type": "object"
    },
    "SpeechRequested": {
      "additionalProperties": false,
      "description": "Intent, not audio. The native layer owns the device.",
      "properties": {
        "interrupt": {
          "default": false,
          "title": "Interrupt",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "speech.requested",
          "default": "speech.requested",
          "title": "Type",
          "type": "string"
        },
        "voice": {
          "description": "A locale, e.g. pt-PT.",
          "title": "Voice",
          "type": "string"
        }
      },
      "required": [
        "text",
        "voice"
      ],
      "title": "SpeechRequested",
      "type": "object"
    },
    "StateChanged": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "idle",
            "listening",
            "thinking",
            "acting",
            "speaking"
          ],
          "title": "State",
          "type": "string"
        },
        "type": {
          "const": "state.changed",
          "default": "state.changed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "StateChanged",
      "type": "object"
    },
    "ToolCompleted": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "speech": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "tool.completed",
          "default": "tool.completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "ok"
      ],
      "title": "ToolCompleted",
      "type": "object"
    },
    "TranscriptionPartial": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "transcription.partial",
          "default": "transcription.partial",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TranscriptionPartial",
      "type": "object"
    },
    "UtteranceSubmit": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The session locale, e.g. pt-PT. Carried, never used to translate the utterance before routing.",
          "title": "Locale"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "utterance.submit",
          "default": "utterance.submit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "UtteranceSubmit",
      "type": "object"
    },
    "VisionSubmit": {
      "additionalProperties": false,
      "description": "One frame, and optionally what to ask about it.\n\nThe same shape as `audio.submit` and for the same reason: a surface\ncaptured it because a person asked for it. `CLAUDE.md` invariant 8 -- the\ncamera may not be started by ambiguous model inference -- is why a frame\narrives as a command rather than being fetched by a tool.\n\nNothing here names a file. The frame crosses as bytes, is answered, and is\nnot persisted.",
      "properties": {
        "image": {
          "description": "base64 of a JPEG or PNG frame.",
          "maxLength": 8000000,
          "title": "Image",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The session locale.",
          "title": "Locale"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What was said while looking, verbatim. Absent means: describe it.",
          "title": "Text"
        },
        "type": {
          "const": "vision.submit",
          "default": "vision.submit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "image"
      ],
      "title": "VisionSubmit",
      "type": "object"
    }
  },
  "$id": "https://ev.local/protocol/ev.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Everything that crosses the socket, for the generated schema's benefit.\n\nEach line on the wire is one of these, so a generator emits one type per\nlanguage rather than three unrelated roots.",
  "properties": {
    "event": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "confirmation.required": "#/$defs/ConfirmationRequired",
              "permission.changed": "#/$defs/PermissionChanged",
              "speech.requested": "#/$defs/SpeechRequested",
              "state.changed": "#/$defs/StateChanged",
              "tool.completed": "#/$defs/ToolCompleted",
              "transcription.partial": "#/$defs/TranscriptionPartial"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TranscriptionPartial"
            },
            {
              "$ref": "#/$defs/SpeechRequested"
            },
            {
              "$ref": "#/$defs/ConfirmationRequired"
            },
            {
              "$ref": "#/$defs/ToolCompleted"
            },
            {
              "$ref": "#/$defs/StateChanged"
            },
            {
              "$ref": "#/$defs/PermissionChanged"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoryPage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/Response"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Envelope",
  "type": "object",
  "x-ev-protocol-version": "1.7"
}
