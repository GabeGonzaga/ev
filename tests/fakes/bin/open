#!/bin/sh
# Fake open(1). Records the exact argv it was given, one argument per line,
# so tests assert on what reached the process boundary rather than on mocks.
#
# EV_FAKE_LOG   file to append the argv to
# EV_FAKE_EXIT  exit code to return, default 0
# EV_FAKE_STDERR text to write to stderr

for argument in "$@"; do
    printf '%s\n' "$argument" >> "$EV_FAKE_LOG"
done

if [ -n "$EV_FAKE_STDERR" ]; then
    printf '%s\n' "$EV_FAKE_STDERR" >&2
fi

exit "${EV_FAKE_EXIT:-0}"
